EXPO_PUBLIC_API_URL=https://hotmess-api.codexeg.net/v1
EXPO_PUBLIC_API_KEY=example

# When "true", every Modules/*/api.ts serves in-memory mock data instead of
# calling the network. Useful for UI testing without a backend.
#
# Note: as of this env, auth (login/logout/checkAuth), inbox (getChats/
# updateStatus), and calendar (getEvents + CRUD) call the real API
# unconditionally — this flag no longer gates them. It still fully gates
# home/profile/team/finance/ads/analytics, which have no backend endpoints
# yet, and it still gates the auth methods with no real equivalent
# (register/verifyOTP/resendOTP/resetPassword/updateProfile). See each
# module's api.ts for specifics.
EXPO_PUBLIC_USE_MOCK_DATA=true
